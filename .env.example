# Database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/buildable_land

# For Railway deployment, use the provided DATABASE_URL from Railway

# API Settings (optional)
API_HOST=0.0.0.0
API_PORT=8000

# CRS Settings (generally don't need to change)
# STORAGE_CRS=4326
# PROJECTED_CRS=6579

# Default buffer distances in feet (can be overridden via API)
# DEFAULT_WETLAND_BUFFER_FT=50.0
# DEFAULT_FLOODPLAIN_BUFFER_FT=25.0
